                title: 'Standalone Club Rig',
                price: '~€1,400+',
                desc: 'No laptop required. USB-drive ready standalone systems modeled after club standard CDJ setups. Perfect for mobile DJs, venue residency prep, and professional gigs.',
                hardware: 'Pioneer XDJ-RR / Denon Prime',
                software: 'Standalone Engine / rekordbox USB'
            }
        ];

        function selectGearTier(index) {
            for(let i=0; i<3; i++) {
                const btn = document.getElementById(`tierBtn${i}`);
                if(i === index) {
                    btn.className = 'controller-pad w-full text-left p-4 rounded-2xl border border-cyan-500 bg-cyan-500/10 transition flex items-center justify-between group';
                } else {
                    btn.className = 'controller-pad w-full text-left p-4 rounded-2xl border border-slate-800 bg-slate-900/50 hover:bg-slate-900 transition flex items-center justify-between group';
                }
            }

            const data = gearTiers[index];
            document.getElementById('gearTierBadge').innerText = data.badge;
            document.getElementById('gearTierTitle').innerText = data.title;
            document.getElementById('gearTierPrice').innerText = data.price;
            document.getElementById('gearTierDesc').innerText = data.desc;
            document.getElementById('gearTierHardware').innerText = data.hardware;
            document.getElementById('gearTierSoftware').innerText = data.software;
        }

        // FAQ Toggle
        function toggleFaq(card) {
            const p = card.querySelector('p');
            const icon = card.querySelector('.faq-icon');
            if(p.classList.contains('hidden')) {
                p.classList.remove('hidden');
                icon.innerText = '−';
            } else {
                p.classList.add('hidden');
                icon.innerText = '+';
            }
        }

        // Filter lessons logic
        function filterLessons(category) {
            const cards = document.querySelectorAll('.lesson-card');
            const allBtn = document.getElementById('btn-all');
            const guitarBtn = document.getElementById('btn-guitar');
            const begBtn = document.getElementById('btn-beginner');
            const groupBtn = document.getElementById('btn-group');
            const specBtn = document.getElementById('btn-specialized');

            [allBtn, guitarBtn, begBtn, groupBtn, specBtn].forEach(b => {
                b.className = 'controller-pad px-3 py-2 rounded-lg text-slate-300 hover:text-white transition';
            });

            if(category === 'all') {
                allBtn.className = 'controller-pad px-3 py-2 rounded-lg bg-cyan-500 text-slate-950 transition';
                cards.forEach(c => c.style.display = 'flex');
            } else if(category === 'guitar') {
                guitarBtn.className = 'controller-pad px-3 py-2 rounded-lg bg-cyan-500 text-slate-950 transition';
                cards.forEach(c => {
                    c.style.display = c.getAttribute('data-category') === 'guitar' ? 'flex' : 'none';
                });
            } else if(category === 'beginner') {
                begBtn.className = 'controller-pad px-3 py-2 rounded-lg bg-cyan-500 text-slate-950 transition';
                cards.forEach(c => {
                    c.style.display = c.getAttribute('data-category') === 'beginner' ? 'flex' : 'none';
                });
            } else if(category === 'group') {
                groupBtn.className = 'controller-pad px-3 py-2 rounded-lg bg-cyan-500 text-slate-950 transition';
                cards.forEach(c => {
                    c.style.display = c.getAttribute('data-category') === 'group' ? 'flex' : 'none';
                });
            } else if(category === 'specialized') {
                specBtn.className = 'controller-pad px-3 py-2 rounded-lg bg-cyan-500 text-slate-950 transition';
                cards.forEach(c => {
                    c.style.display = c.getAttribute('data-category') === 'specialized' ? 'flex' : 'none';
                });
            }
        }

        // DJ Modal control
        function openBookingModal(title, price) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalPrice').innerText = price;
            const modal = document.getElementById('bookingModal');
            modal.style.display = 'flex';
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').style.display = 'none';
        }

        function handleBookingSubmit(event) {
            event.preventDefault();
            closeBookingModal();
            
            const toast = document.getElementById('toast');
            toast.innerText = "DJ session booking request submitted successfully!";
            toast.classList.add('flex');
            toast.classList.remove('hidden', 'translate-y-10', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => toast.classList.add('hidden'), 300);
            }, 4000);
            
            document.getElementById('bookingForm').reset();
        }

        // Guitar Modal control
        function openGuitarModal() {
            document.getElementById('guitarModal').style.display = 'flex';
        }

        function closeGuitarModal() {
            document.getElementById('guitarModal').style.display = 'none';
        }

        function handleGuitarSubmit(event) {
            event.preventDefault();
            closeGuitarModal();
            
            const day = document.getElementById('guitarDaySelect').value;
            const toast = document.getElementById('toast');
            toast.innerText = `Guitar lesson booked for ${day} (2:40 PM - 3:40 PM)!`;
            toast.classList.add('flex');
            toast.classList.remove('hidden', 'translate-y-10', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => toast.classList.add('hidden'), 300);
            }, 4000);
            
            document.getElementById('guitarForm').reset();
        }
    </script>
</body>
</html>