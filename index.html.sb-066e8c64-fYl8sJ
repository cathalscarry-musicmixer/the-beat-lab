    <script>
        // Audio Player Simulation & Serato EQ / Spectrum Visualizer
        let isPlaying = false;
        let audioInterval;
        let currentTime = 0;

        function toggleAudio() {
            const playBtn = document.getElementById('playBtn');
            const playIcon = document.getElementById('playIcon');
            const visualizerBars = document.querySelectorAll('#visualizer span');

            isPlaying = !isPlaying;

            if(isPlaying) {
                playIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
                playBtn.classList.add('animate-pulse');
                
                audioInterval = setInterval(() => {
                    currentTime++;
                    if(currentTime > 30) currentTime = 0;
                    
                    let secs = currentTime < 10 ? '0' + currentTime : currentTime;
                    document.getElementById('trackTime').innerText = `0:${secs} / 0:30`;

                    visualizerBars.forEach(bar => {
                        let randomHeight = Math.floor(Math.random() * 42) + 8;
                        bar.style.height = randomHeight + 'px';
                    });
                }, 150);
            } else {
                playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
                playBtn.classList.remove('animate-pulse');
                clearInterval(audioInterval);
                document.getElementById('trackTime').innerText = '0:00 / 0:30';
                visualizerBars.forEach((bar, idx) => {
                    bar.style.height = (12 + (idx % 4) * 8) + 'px';
                });
            }
        }

        // EQ Knob / Slider updates
        function updateEQ(band, val) {
            const formatted = val > 0 ? `+${val}dB` : `${val}dB`;
            if(band === 'hi') document.getElementById('hiVal').innerText = formatted;
            if(band === 'mid') document.getElementById('midVal').innerText = formatted;
            if(band === 'low') document.getElementById('lowVal').innerText = formatted;
        }

        // Cart counter
        let cartCount = 0;
        function addToCart(itemTitle, price) {
            cartCount++;
            document.getElementById('cartCount').innerText = cartCount;
            
            const toast = document.getElementById('toast');
            toast.innerText = `Added "${itemTitle}" to cart! (€${price})`;
            toast.classList.remove('hidden', 'translate-y-10', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => toast.classList.add('hidden'), 300);
            }, 3500);
        }

